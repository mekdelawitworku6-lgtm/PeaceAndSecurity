{
  "name": "peace-and-security-backend",
  "version": "1.0.0",
  "description": "Peace and Security Backend: Environmental monitoring system with auth, OTP, push notifications, and report management.",
  "scripts": {
    "build": "nest build",
    "test": "ts-node --transpile-only -r tsconfig-paths/register scripts/verify-otp.ts && ts-node --transpile-only -r tsconfig-paths/register scripts/verify-pin-reset.ts",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "format": "prettier --write \"src/**/*.ts\"",
    "db:gen": "npm run build && typeorm-ts-node-commonjs -d dist/database/data-source.js migration:generate src/database/migrations/Auto",
    "db:run": "typeorm-ts-node-commonjs -d dist/database/data-source.js migration:run",
    "db:revert": "typeorm-ts-node-commonjs -d dist/database/data-source.js migration:revert",
    "db:seed": "ts-node -r tsconfig-paths/register src/database/seeds/seed-runner.ts",
    "seed:report-types": "ts-node -r tsconfig-paths/register seed-report-types.ts"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/schedule": "^6.1.0",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^10.0.0",
    "@nestjs/websockets": "^10.4.22",
    "axios": "^1.13.6",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dayjs": "^1.11.19",
    "dotenv": "^16.4.7",
    "firebase-admin": "^13.7.0",
    "jsonwebtoken": "^9.0.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.4.1",
    "joi": "^18.0.1",
    "moment": "^2.30.1",
    "moment-timezone": "^0.6.0",
    "multer": "^1.4.5-lts.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.18.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "sharp": "^0.33.3",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "0.3.28",
    "mime-types": "^2.1.35",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.16",
    "@nestjs/schematics": "^10.0.3",
    "@nestjs/testing": "^10.3.0",
    "@types/bcrypt": "^6.0.0",
    "@types/body-parser": "^1.19.6",
    "@types/caseless": "^0.12.5",
    "@types/eslint": "^9.6.1",
    "@types/express": "^4.17.21",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/http-errors": "^2.0.5",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/mime-types": "^3.0.1",
    "@types/moment": "^2.11.29",
    "@types/moment-timezone": "^0.5.13",
    "@types/multer": "^2.0.0",
    "@types/node": "^26.1.2",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^3.0.13",
    "@types/passport-local": "^1.0.38",
    "@types/passport-strategy": "^0.2.38",
    "@types/qs": "^6.15.1",
    "@types/range-parser": "^1.2.7",
    "@types/send": "^1.2.1",
    "@types/serve-static": "^2.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/tough-cookie": "^4.0.5",
    "prettier": "^3.3.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.3"
  }
}